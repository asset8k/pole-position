# Copy to .env and fill in. Never commit the real .env.

# Required
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pole_position
DATABASE_SSL=false
# Supabase production connections use the official CA shipped with the repo.
# DATABASE_SSL_CA_FILE=./data/certificates/supabase-ca.crt
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32

# PostgreSQL integration tests (must be a separate database)
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pole_position_test

# Tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional private monitoring; empty disables /internal/keepalive (HTTP 403).
# Generate a NEW Pole Position-only token during setup; never reuse another app's.
KEEPALIVE_TOKEN=

# OpenAI
OPENAI_API_KEY=your_openai_api_key
ANSWER_MODEL=gpt-6-luna
RERANK_ENABLED=true

# Qdrant
QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=your_qdrant_collection

# Exact frontend origins; no trailing slash. Add the deployed Vercel URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud only: prepare this bundle before deployment; local development uses the repo.
# CORPUS_ROOT=./deployment_data
VALIDATE_CORPUS_ON_STARTUP=false
